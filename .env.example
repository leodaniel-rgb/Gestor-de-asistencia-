# Copia este archivo como .env.local y llena los valores reales.
# .env.local está en .gitignore: NUNCA lo subas al repositorio.
# En Vercel, estos valores se configuran en Project Settings → Environment Variables.

# --- Supabase (se usan a partir de la fase F1) ---
# Públicas: llegan al navegador. Son seguras SOLO si todas las tablas tienen RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Secreta: solo servidor (crear/eliminar cuentas de entrenadores).
# Nunca la uses en un componente cliente ni con el prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx
